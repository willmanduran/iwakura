# Networking & Localization
# The internal port where the Data Hub lives
DASH_PORT=8888
# Set to 0.0.0.0 to listen on your whole local network or 127.0.0.1 for local only
DASH_HOST=0.0.0.0
# The internal UDP port used to sync panel data
ORCH_PORT=8889
# The broadcast tower port where frontends connect to grab the data stream
FRONTEND_PORT=8891
# The port for the guestbook web portal where people can leave messages
GUESTBOOK_PORT=8890
# Choose your interface language. Current options are en or es
IWAKURA_LANG="en"

# Module Toggles
# Toggle these to 1 to run the service or 0 to keep it dead
ENABLE_WEATHER=1
ENABLE_MUSIC=1
ENABLE_CALENDAR=1
ENABLE_NEWS=1
ENABLE_GUESTBOOK=1

# Refresh Rates
# How many seconds between each update. Don't set these too low or APIs will kick you out
# Weather update interval
REFRESH_WX=900
# Spotify playback sync
REFRESH_MUSIC=6
# Last.fm stats update
REFRESH_LFM=300
# Calendar and Task sync
REFRESH_CAL=600
# RSS feed fetcher interval
REFRESH_NEWS=300
# How fast the guestbook cycles through messages on the TUI
REFRESH_GB=15

# Guestbook UI
# The title of the web portal page
GB_TITLE="Iwakura Guestbook"
# The big header text above the message form
GB_HEADING="Leave a message"
# Web portal colors in Hex format
GB_BG_COLOR="#050505"
GB_FG_COLOR="#00ff00"
GB_BTN_COLOR="#008800"

# Weather Setup
# Your latitude and longitude for Open-Meteo data
WX_LAT="0.0"
WX_LON="0.0"

# Spotify Music Sync
# Grab these from your Spotify Developer Dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
# Your permanent refresh token for headless authentication
SPOTIFY_REFRESH_TOKEN=""

# Last.fm Statistics
# API key from Last.fm
LASTFM_API_KEY=""
# Your actual Last.fm username
LASTFM_USER=""
# A custom name for your profile that shows up on the dashboard
LASTFM_DISPLAY_NAME="User"

# Calendar & Tasks
# The full CalDAV URL for your calendar provider
CAL_URL="http://ip:port/username/calname/"
# Your CalDAV login credentials
CAL_USER=""
CAL_PASS=""

# News Aggregator
# Absolute path to the text file where you list your RSS feed URLs
RSS_LIST_PATH="/home/user/.iwakura/rss.txt"

# FRONTEND ONLY SETTINGS
# Use these if you are installing just the UI on a different machine

# The IP address of your Backend server
# DASH_HOST="some_ip"
# Must match the FRONTEND_PORT set on the server
# FRONTEND_PORT=8891
# Preferred language for the TUI labels
# IWAKURA_LANG="en"